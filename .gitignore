# ============================================================
# 올리지 않는 것
# ============================================================

# 대화 기록.
#
# 다이아와 나눈 이야기가 통째로 들어 있다. 친밀도·호칭·기분까지.
# 공개 저장소에 올릴 것이 아니다.
memory_store.json
memory_archive/

# 걷어낸 표시 기록 (어떤 몸짓이 왜 나왔는지 따져 보려고 남기는 것)
_cue_log.txt

# 아바타 파일.
#
# 웹이 쓰는 것은 avatar.vrm 하나다(겹치기가 꺼져 있어 body.vrm 은 안 쓴다).
# 2026-09-28 에 만든이(본인)가 라이선스를 CC_BY_NC 로 바꿔서 이것만 올린다
# (_relicense_vrm.py). 나머지 VRM 은 아직 Redistribution_Prohibited 거나
# 안 쓰는 판이라 그대로 뺀다.
static/*.vrm
!static/avatar.vrm
static/skin/*.png

# 배경 이미지 (개인 파일)
static/background/*
!static/background/읽어주세요.txt

# 단계별로 남겨 둔 원본
_backup_*/

# 파이썬
__pycache__/
*.pyc
*.pyo

# 임시
*.tmp
memory_*.tmp

# 고치기 전에 손으로 떠 둔 원본 (avatar.py.bak_kiss 같은 것).
# 되돌릴 일이 있을 때 쓰려고 남겨 두는 것이라 저장소에는 안 올린다 —
# 판을 낸 뒤로는 git 이력이 같은 일을 한다.
*.bak
*.bak_*

# 계정.
#
# 비밀번호는 되돌릴 수 없는 값으로 바꿔 두었지만, 누가 어떤 아이디를
# 쓰는지까지 올릴 이유가 없다.
accounts.json

# 쿠키에 서명하는 열쇠. 이게 새면 남의 쿠키를 지어낼 수 있다.
.secret_key

# 사람마다 갈라 둔 기억. memory_store.json 과 같은 이유로 올리지 않는다.
memory/
.vercel
.env*

# 터널 실행 파일(cloudflared). 받아 쓰는 것이라 저장소에 둘 이유가 없다.
_tools/

# 올릴 때마다 새로 적히는 지문. 올린 것이 방금 그것인지 확인하는 데만 쓴다.
build.json

# 목소리 만드는 열쇠(Gemini). 새면 남이 내 몫을 쓴다.
.gemini_key

# 만들어 둔 목소리. 다시 만들 수 있는 것이라 안 올린다.
_voice_cache/

# 옷장에 구운 옷(wardrobe/*.vrm)은 올린다.
#
# 아바타에서 떼어 낸 것이라 예전엔 막았는데, 2026-09-28 에 avatar.vrm 과
# 함께 CC_BY_NC 로 바꿨다. 새 옷을 구우면 원본이 재배포 허용인지 먼저 볼 것
# — 굽는 도구는 원본의 라이선스를 그대로 옮긴다.

# 옷장에 넣으려고 떨군 원본 VRM 도 아바타에서 나온 것이다.
# 구운 옷과 같은 이유로 저장소에 안 올린다.
static/wardrobe/_새로넣기/*.vrm
static/wardrobe/_넣은것/

# 굽는 데 쓰는 크롬 프로필. 다시 만들면 되는 것이다.
_bake_profile/

# 구운 다이아 그림.
#
# 아바타를 돌려 만든 것이라 **아바타를 다시 뿌리는 것과 같다.**
# 파일 안에 Redistribution_Prohibited 가 박혀 있는 물건에서 나왔으므로
# static/*.vrm 과 같은 자리에 둔다. VRoid 에서 재배포 허용으로 다시
# 내보내면 그때 풀면 된다.
#
# 다시 만드는 법: python _bake_sprites.py
static/sprites/

# Live2D 공식 샘플 — 무료 소재 라이선스, 저장소에는 안 올린다(이 PC 검증용)
static/live2d/sample/
